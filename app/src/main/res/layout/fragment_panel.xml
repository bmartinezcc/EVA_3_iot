<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSaludo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp" />

        <!-- Solo visible para ADMIN -->
        <LinearLayout
            android:id="@+id/layoutAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/titulo_control"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAbrir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_abrir" />

            <Button
                android:id="@+id/btnCerrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_cerrar" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/titulo_tarjetas"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etUid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_uid"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="8"
                android:minHeight="48dp" />

            <Button
                android:id="@+id/btnAddTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_add_tarjeta" />

            <Button
                android:id="@+id/btnDelTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_del_tarjeta" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/titulo_claves"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etClaveNueva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_clave_nueva"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:maxLength="8"
                android:minHeight="48dp" />

            <Button
                android:id="@+id/btnAddClave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_add_clave" />

            <Button
                android:id="@+id/btnDelClave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_del_clave" />

            <Button
                android:id="@+id/btnGenerarClave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_generar_clave" />

            <TextView
                android:id="@+id/tvClaveGenerada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_historial" />

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_cerrar_sesion" />
    </LinearLayout>
</ScrollView>
